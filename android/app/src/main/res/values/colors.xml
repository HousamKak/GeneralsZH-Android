<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- GeneralsX @feature ZH Commander 09/10/2026 Design tokens for every screen this app
         draws itself (activation, game data, update, Support), retuned to the landing site's
         "desert campaign field kit": sand ground, canvas surfaces, olive-drab and gunmetal ink,
         one hazard-orange accent. Same names as the earlier dark palette, so themes.xml and
         the Java that reads them did not change.

         GeneralsZHActivity (the game surface itself) never references any of these: it stays
         on its own plain fullscreen theme, and the game's menus keep their own look. -->

    <!-- Ground + surface ladder: sand, then canvas tones for cards and rows on top of it. -->
    <color name="gzh_background">#D2C192</color>
    <color name="gzh_surface">#D8C899</color>
    <color name="gzh_surface_container_low">#DCCDA2</color>
    <color name="gzh_surface_container">#E4D8B3</color>
    <color name="gzh_surface_container_high">#EAE0C2</color>
    <color name="gzh_surface_container_highest">#F0E8D0</color>

    <!-- Content on those surfaces: gunmetal ink, olive drab, and a dust tone that still clears
         4.5:1 at 12sp on the canvas card. -->
    <color name="gzh_on_surface">#1D1F14</color>
    <color name="gzh_on_surface_variant">#4A5228</color>
    <color name="gzh_on_surface_faint">#5A5641</color>
    <color name="gzh_outline">#4A5228</color>
    <color name="gzh_outline_variant">#B8A97D</color>

    <!-- Primary: hazard orange (the hero action, active nav item, selected segment). -->
    <color name="gzh_primary">#C2461B</color>
    <color name="gzh_on_primary">#FFF8EC</color>
    <color name="gzh_primary_container">#EDCFB8</color>
    <color name="gzh_on_primary_container">#5A1F08</color>
    <color name="gzh_primary_dark">#1D1F14</color>
    <color name="gzh_accent">#C2461B</color>

    <!-- Secondary: olive drab, for tonal buttons and chips. -->
    <color name="gzh_secondary">#4A5228</color>
    <color name="gzh_on_secondary">#F0E8CF</color>
    <color name="gzh_secondary_container">#CBC392</color>
    <color name="gzh_on_secondary_container">#23270F</color>

    <!-- Tertiary: destructive / "clear" actions, a deep brick that reads apart from the accent. -->
    <color name="gzh_tertiary">#8C2F17</color>
    <color name="gzh_on_tertiary">#FFF1E8</color>
    <color name="gzh_tertiary_container">#E6C1AE</color>
    <color name="gzh_on_tertiary_container">#4A1406</color>

    <color name="gzh_error">#A3261B</color>
    <color name="gzh_on_error">#FFFFFF</color>
    <color name="gzh_error_container">#F2D3C8</color>
    <color name="gzh_on_error_container">#410C05</color>

    <!-- Disabled state (M3: 38% of on-surface for content, 12% for containers) -->
    <color name="gzh_on_surface_disabled">#611D1F14</color>
    <color name="gzh_container_disabled">#1F1D1F14</color>
    <color name="gzh_ripple_light">#1F1D1F14</color>
    <color name="gzh_ripple_primary">#33C2461B</color>

    <!-- Status lines (game-data check, updates) on the light ground. -->
    <color name="gzh_status_ok">#2E6B34</color>
    <color name="gzh_status_warn">#8A5A00</color>
    <color name="gzh_status_error">#A3261B</color>
</resources>
