{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "zh-commander",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"observability": { "enabled": true },
	// Public half of the license server's signing key (LicenseGate.PUBLIC_KEY_B64): game data
	// is served only to requests carrying a license it signed.
	// MONITOR_*: App Monitor's ingest and this app's public ingest key (identifies the app, not a
	// secret), for the site's visit and download counts (src/hit.ts). The hash salt is a secret.
	"vars": {
		"LICENSE_PUBLIC_KEY": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEAhE861NJAUCPcAoeya8LDyNmUux2QKucHdX3ndZ+IjYbkPYVqQU/GXBmn5tsuKg1Wp3b70Xx6aLSbsvJEfjOmg==",
		"MONITOR_INGEST_URL": "https://ingest.housamkak.com",
		"MONITOR_APP_KEY": "am_9744dcb336496025978f89b4446a2e8295b0"
	},
	// Kept on next to the custom domain: upload-apk.sh publishes through it, since it resolves
	// even where a resolver still caches the custom domain as missing.
	"workers_dev": true,
	"routes": [
		{ "pattern": "zerohour.housamkak.com", "custom_domain": true }
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/hero/*", "/download", "/download/*", "/api/*", "/admin/*", "/data/*", "/altstore.json"]
	},
	// PayPal checkout lives in the license server; /api/paypal/* is forwarded to it.
	"services": [
		{ "binding": "LICENSE", "service": "gzh-license" }
	],
	"r2_buckets": [
		{ "binding": "APKS", "bucket_name": "zh-commander-apk" }
	]
}
